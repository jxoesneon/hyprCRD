#!/usr/bin/env python3
"""
hyprcrd - Unified Native CLI for Chrome Remote Desktop on Hyprland
Provides 1:1 parity with Google's official CRD service, native Wayland
streaming via PipeWire, and emulated input via libei and virtual devices.
"""

import os
import sys
import time
import signal
import psutil
import argparse
import subprocess
import hashlib
import tempfile
import urllib.request
from pathlib import Path

__version__ = "1.0.0"

BASE_DIR = Path(__file__).resolve().parent.parent
BIN_DIR = BASE_DIR / "bin"
CORE_DIR = BASE_DIR / "core"
TEST_DIR = BASE_DIR / "test"
CONFIG_DIR = Path.home() / ".config" / "chrome-remote-desktop"


def runtime_dir() -> Path:
    base = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    return Path(base) / "hyprcrd"


def state_dir() -> Path:
    base = os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local" / "state"))
    return Path(base) / "hyprcrd"


PID_FILE = runtime_dir() / "hyprcrd.pid"
LOG_FILE = state_dir() / "hyprcrd.log"

# Terminal colors
CYAN = "\033[0;36m"
GREEN = "\033[0;32m"
YELLOW = "\033[1;33m"
RED = "\033[0;31m"
BOLD = "\033[1m"
NC = "\033[0m"


def find_component(name):
    env_name = "HYPRCRD_" + name.upper().replace("-", "_").replace(".", "_")
    if os.environ.get(env_name) and Path(os.environ[env_name]).exists():
        return Path(os.environ[env_name])
    script_dir = Path(__file__).resolve().parent
    for candidate in [
        BIN_DIR / name,
        script_dir / name,
        script_dir.parent / "lib" / "hyprcrd" / name,
        Path.home() / ".local" / "lib" / "hyprcrd" / name,
        Path(f"/usr/lib/hyprcrd/{name}"),
        Path(f"/usr/local/lib/hyprcrd/{name}"),
        Path(f"/app/lib/hyprcrd/{name}"),
    ]:
        if candidate.exists():
            return candidate
    return BIN_DIR / name


def find_crd_version_env():
    """Locate crd_version.env (single source of truth for the pinned CRD package)."""
    env_override = os.environ.get("HYPRCRD_CRD_VERSION_ENV")
    if env_override and Path(env_override).exists():
        return Path(env_override)
    script_dir = Path(__file__).resolve().parent
    for candidate in [
        BASE_DIR / "scripts" / "crd_version.env",
        script_dir / "crd_version.env",
        script_dir.parent / "share" / "hyprcrd" / "crd_version.env",
        Path("/usr/share/hyprcrd/crd_version.env"),
        Path("/usr/local/share/hyprcrd/crd_version.env"),
        Path("/app/share/hyprcrd/crd_version.env"),
    ]:
        if candidate.exists():
            return candidate
    return None


def load_crd_version():
    """Parse CRD_VERSION / CRD_SHA256 / URLs from crd_version.env."""
    env_path = find_crd_version_env()
    values = {}
    if env_path:
        for line in env_path.read_text().splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, _, value = line.partition("=")
            values[key.strip()] = value.strip().strip('"')
    url = values.get(
        "CRD_DEB_URL",
        "https://dl.google.com/linux/chrome-remote-desktop/deb/pool/main/c/"
        f"chrome-remote-desktop/chrome-remote-desktop_{values.get('CRD_VERSION', '')}_amd64.deb",
    )
    # The env file writes the URL with a literal ${CRD_VERSION} placeholder.
    url = url.replace("${CRD_VERSION}", values.get("CRD_VERSION", ""))
    return {
        "version": values.get("CRD_VERSION", ""),
        "sha256": values.get("CRD_SHA256", ""),
        "url": url,
        "packages_url": values.get(
            "CRD_PACKAGES_URL",
            "https://dl.google.com/linux/chrome-remote-desktop/deb/dists/"
            "stable/main/binary-amd64/Packages",
        ),
    }


def _google_component_dir():
    """Directory where the Google host components should live.

    Prefers the directory where hyprcrd-portal already resolves; falls back to
    the user-level lib dir so `install-host` works without root.
    """
    portal = find_component("hyprcrd-portal")
    if portal.exists():
        return portal.parent
    local = Path.home() / ".local" / "lib" / "hyprcrd"
    local.mkdir(mode=0o755, parents=True, exist_ok=True)
    return local


def _extract_deb(deb_path, work_dir):
    data_tar = work_dir / "data.tar.xz"
    try:
        subprocess.run(
            ["bsdtar", "-xf", str(deb_path), "-C", str(work_dir), "data.tar.xz"],
            check=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except (FileNotFoundError, subprocess.CalledProcessError):
        subprocess.run(
            ["ar", "x", str(deb_path), "data.tar.xz"],
            check=True,
            cwd=work_dir,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    if not data_tar.exists():
        raise RuntimeError("data.tar.xz not found in .deb payload")
    data_dir = work_dir / "data"
    data_dir.mkdir()
    subprocess.run(
        ["tar", "-xf", str(data_tar), "-C", str(data_dir)],
        check=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    return data_dir / "opt" / "google" / "chrome-remote-desktop"


def cmd_install_host(args):
    meta = load_crd_version()
    if not meta["version"] or not meta["sha256"]:
        print(f"{RED}Could not read pinned CRD version (crd_version.env missing).{NC}")
        sys.exit(1)

    target_dir = _google_component_dir()
    print(f"Fetching Google Chrome Remote Desktop {meta['version']}...")
    with tempfile.TemporaryDirectory(prefix="hyprcrd-crd-") as tmp:
        deb_path = Path(tmp) / "crd.deb"
        try:
            with urllib.request.urlopen(meta["url"], timeout=60) as r:  # nosec B310
                deb_path.write_bytes(r.read())
        except Exception as e:
            print(f"{RED}Download failed: {e}{NC}")
            sys.exit(1)

        digest = hashlib.sha256(deb_path.read_bytes()).hexdigest()
        if digest != meta["sha256"]:
            print(f"{RED}Checksum mismatch; refusing to install.{NC}")
            print(f"  expected: {meta['sha256']}")
            print(f"  actual:   {digest}")
            sys.exit(1)
        print("Checksum verified.")

        try:
            deb_root = _extract_deb(deb_path, Path(tmp))
        except (FileNotFoundError, subprocess.CalledProcessError, RuntimeError) as e:
            print(f"{RED}Extraction failed (need bsdtar or ar+tar): {e}{NC}")
            sys.exit(1)

        try:
            target_dir.mkdir(parents=True, exist_ok=True)
            for name in (
                "chrome-remote-desktop-host",
                "crashpad-handler",
                "native-messaging-host",
                "start-host",
            ):
                src = deb_root / name
                if src.exists():
                    dst = target_dir / name
                    dst.write_bytes(src.read_bytes())
                    dst.chmod(0o755)
            for name in ("libremoting_core.so", "icudtl.dat"):
                src = deb_root / name
                if src.exists():
                    dst = target_dir / name
                    dst.write_bytes(src.read_bytes())
                    dst.chmod(0o644)
            locales = deb_root / "remoting_locales"
            if locales.is_dir():
                import shutil

                dst = target_dir / "remoting_locales"
                if dst.exists():
                    shutil.rmtree(dst)
                shutil.copytree(locales, dst)
        except PermissionError as e:
            print(f"{RED}Cannot write to {target_dir}: {e}{NC}")
            print("Re-run with elevated privileges for a system install.")
            sys.exit(1)

    print(f"Google host components {meta['version']} installed to {target_dir}.")
    if PID_FILE.exists():
        try:
            if psutil.pid_exists(int(PID_FILE.read_text().strip())):
                print(
                    f"{YELLOW}hyprCRD is running; restart it to use the new host binary.{NC}"
                )
        except Exception:
            pass


def cmd_check_host_update(args):
    meta = load_crd_version()
    try:
        with urllib.request.urlopen(
            meta["packages_url"], timeout=15
        ) as r:  # nosec B310
            index = r.read().decode("utf-8", "replace")
    except Exception as e:
        print(f"{RED}Could not fetch upstream package index: {e}{NC}")
        sys.exit(1)
    versions = []
    in_pkg = False
    for line in index.splitlines():
        if line.startswith("Package: chrome-remote-desktop"):
            in_pkg = True
        elif line.startswith("Package: "):
            in_pkg = False
        elif in_pkg and line.startswith("Version: "):
            versions.append(line.split(":", 1)[1].strip())
    if not versions:
        print(f"{RED}No chrome-remote-desktop versions found in index.{NC}")
        sys.exit(1)

    def _key(v):
        return [int(p) if p.isdigit() else p for p in v.replace("-", ".").split(".")]

    latest = sorted(versions, key=_key)[-1]
    print(f"Pinned: {meta['version']}")
    print(f"Latest: {latest}")
    if latest == meta["version"]:
        print("hyprCRD is pinned to the latest upstream release.")
    else:
        print(f"{YELLOW}A newer upstream release is available.{NC}")
        print("Update scripts/crd_version.env, the packaging manifests, and run")
        print("'hyprcrd install-host' after review.")


def find_daemon():
    script_dir = Path(__file__).resolve().parent
    for candidate in [
        CORE_DIR / "daemon.py",
        script_dir / "daemon.py",
        script_dir.parent / "lib" / "hyprcrd" / "daemon.py",
        Path("/usr/lib/hyprcrd/daemon.py"),
        Path("/usr/local/lib/hyprcrd/daemon.py"),
        Path("/app/lib/hyprcrd/daemon.py"),
    ]:
        if candidate.exists():
            return candidate
    return CORE_DIR / "daemon.py"


def print_banner():
    print(f"{BOLD}hyprCRD{NC} - Wayland host for Chrome Remote Desktop\n")


def cmd_doctor(args):
    print(f"{BOLD}[hyprCRD Doctor] System Verification:{NC}")

    checks = [
        ("Base directory", BASE_DIR.exists(), str(BASE_DIR)),
        (
            "Host binary (from .deb)",
            find_component("chrome-remote-desktop-host").exists(),
            (
                str(find_component("chrome-remote-desktop-host"))
                if find_component("chrome-remote-desktop-host").exists()
                else "missing; run 'hyprcrd install-host'"
            ),
        ),
        (
            "libremoting_core.so",
            find_component("libremoting_core.so").exists(),
            str(find_component("libremoting_core.so")),
        ),
        (
            "hyprcrd-portal binary",
            find_component("hyprcrd-portal").exists(),
            str(find_component("hyprcrd-portal")),
        ),
        (
            "PAM authorization shim",
            find_component("pam_shim.so").exists(),
            str(find_component("pam_shim.so")),
        ),
        (
            "Host credentials file",
            bool(list(CONFIG_DIR.glob("host#*.json"))),
            f"Found in {CONFIG_DIR}",
        ),
    ]

    # Check Wayland display
    active_display = os.environ.get("WAYLAND_DISPLAY")
    checks.append(
        (
            "Active WAYLAND_DISPLAY",
            bool(active_display),
            active_display or "None detected",
        )
    )

    # Check PipeWire
    pw_check = subprocess.run(
        ["pgrep", "-a", "pipewire"], stdout=subprocess.PIPE, text=True
    )
    checks.append(
        (
            "PipeWire server",
            pw_check.returncode == 0,
            (
                pw_check.stdout.strip().split("\n")[0]
                if pw_check.returncode == 0
                else "Not running"
            ),
        )
    )

    # Check xdg-desktop-portal-hyprland
    xdph_check = subprocess.run(
        ["pgrep", "-f", "xdg-desktop-portal-hyprland"],
        stdout=subprocess.PIPE,
        text=True,
    )
    checks.append(
        (
            "Hyprland Portal backend",
            xdph_check.returncode == 0,
            "Active" if xdph_check.returncode == 0 else "Not running",
        )
    )

    all_passed = True
    for name, status, detail in checks:
        if status:
            print(f"  {GREEN}[ok]{NC} {BOLD}{name:<28}{NC}: {detail}")
        else:
            print(f"  {RED}[fail]{NC} {BOLD}{name:<28}{NC}: {detail}")
            all_passed = False

    print()
    if all_passed:
        print(f"{GREEN}All diagnostic checks passed. System ready.{NC}")
    else:
        print(f"{YELLOW}Some components require attention.{NC}")


def cmd_test(args):
    test_script = TEST_DIR / "run_isolated_test.sh"
    if not test_script.exists():
        print(f"{RED}Error: Test script {test_script} not found.{NC}")
        sys.exit(1)

    subprocess.run([str(test_script)], check=False)


def cmd_start(args):
    if PID_FILE.exists():
        try:
            pid = int(PID_FILE.read_text().strip())
            if psutil.pid_exists(pid):
                print(f"{YELLOW}hyprCRD is already running (PID: {pid}).{NC}")
                return
        except Exception:
            pass

    display = args.display or os.environ.get("WAYLAND_DISPLAY", "wayland-1")
    daemon_py = find_daemon()

    cmd = [sys.executable, "-u", str(daemon_py), f"--display={display}"]
    if args.config:
        cmd.append(f"--config={args.config}")

    if args.foreground:
        print(f"{GREEN}Starting hyprCRD in foreground on {display}...{NC}")
        subprocess.run(cmd)
    else:
        print(f"{GREEN}Starting hyprCRD daemon on {display}...{NC}")
        PID_FILE.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        LOG_FILE.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        log_file = open(LOG_FILE, "a", buffering=1)
        env = os.environ.copy()
        env["PYTHONUNBUFFERED"] = "1"
        proc = subprocess.Popen(
            cmd,
            env=env,
            stdout=log_file,
            stderr=subprocess.STDOUT,
            start_new_session=True,
        )
        PID_FILE.write_text(str(proc.pid))
        print(f"hyprCRD started (PID: {proc.pid}). Logs at {LOG_FILE}")


def cmd_stop(args):
    stopped = False
    if PID_FILE.exists():
        try:
            pid = int(PID_FILE.read_text().strip())
            if psutil.pid_exists(pid):
                print(f"Stopping hyprCRD daemon (PID: {pid})...")
                os.kill(pid, signal.SIGTERM)
                time.sleep(1)
                if psutil.pid_exists(pid):
                    os.kill(pid, signal.SIGKILL)
                stopped = True
        except Exception as e:
            print(f"{YELLOW}Error reading PID file: {e}{NC}")
        try:
            PID_FILE.unlink(missing_ok=True)
        except Exception:
            pass

    # Stop portal if lingering
    for proc in psutil.process_iter(["pid", "name", "cmdline"]):
        try:
            cmdline = " ".join(proc.info["cmdline"] or [])
            if (
                "hyprcrd-portal" in cmdline
                or "chrome-remote-desktop-host" in cmdline
                and str(BASE_DIR) in cmdline
            ):
                proc.terminate()
                stopped = True
        except (psutil.NoSuchProcess, psutil.AccessDenied):
            pass

    if stopped:
        print(f"{GREEN}hyprCRD stopped successfully.{NC}")
    else:
        print(f"{YELLOW}hyprCRD was not running.{NC}")


def cmd_status(args):
    is_running = False
    daemon_pid = None
    if PID_FILE.exists():
        try:
            pid = int(PID_FILE.read_text().strip())
            if psutil.pid_exists(pid):
                is_running = True
                daemon_pid = pid
        except Exception:
            pass
    if not is_running:
        for proc in psutil.process_iter(["pid", "cmdline"]):
            try:
                cmdline = " ".join(proc.info["cmdline"] or [])
                if "daemon.py" in cmdline and str(BASE_DIR) in cmdline:
                    is_running = True
                    daemon_pid = proc.info["pid"]
                    break
            except (psutil.NoSuchProcess, psutil.AccessDenied):
                pass

    print(f"{BOLD}[hyprCRD Status]{NC}")
    if is_running:
        print(f"  Daemon:         {GREEN}ACTIVE{NC} (PID: {daemon_pid})")
    else:
        print(f"  Daemon:         {RED}INACTIVE{NC}")

    # Portal status
    portal_active = False
    for proc in psutil.process_iter(["pid", "name"]):
        if proc.info["name"] == "hyprcrd-portal":
            print(f"  Portal Bridge:  {GREEN}ONLINE{NC} (PID: {proc.info['pid']})")
            portal_active = True
            break
    if not portal_active:
        print(f"  Portal Bridge:  {YELLOW}STANDBY{NC}")

    # Registered host configs
    configs = list(CONFIG_DIR.glob("host#*.json"))
    if configs:
        import json

        for cfg in configs:
            try:
                with open(cfg) as f:
                    d = json.load(f)
                    print(
                        f"  Enrolled Host:  {GREEN}{d.get('host_name')}{NC} (ID: {d.get('host_id')})"
                    )
            except Exception:
                pass
    else:
        print(f"  Enrolled Host:  {YELLOW}None{NC} (Run 'hyprcrd register' to enroll)")


def main():
    print_banner()
    parser = argparse.ArgumentParser(description="hyprCRD CLI")
    parser.add_argument(
        "-v", "--version", action="version", version=f"hyprCRD {__version__}"
    )
    subparsers = parser.add_subparsers(dest="command", help="Command to run")

    # start
    p_start = subparsers.add_parser(
        "start", help="Start the hyprCRD native host daemon"
    )
    p_start.add_argument(
        "--display",
        help="Target Wayland display (default: $WAYLAND_DISPLAY or wayland-1)",
    )
    p_start.add_argument("--config", help="Custom host config JSON path")
    p_start.add_argument(
        "-f",
        "--foreground",
        action="store_true",
        help="Run in foreground instead of background",
    )
    p_start.set_defaults(func=cmd_start)

    # stop
    p_stop = subparsers.add_parser("stop", help="Stop the running hyprCRD host")
    p_stop.set_defaults(func=cmd_stop)

    # restart
    p_restart = subparsers.add_parser("restart", help="Restart hyprCRD")
    p_restart.add_argument("--display", help="Target Wayland display")
    p_restart.add_argument("--config", help="Custom host config JSON path")
    p_restart.add_argument(
        "-f", "--foreground", action="store_true", help="Run in foreground"
    )
    p_restart.set_defaults(
        func=lambda args: (cmd_stop(args), time.sleep(1), cmd_start(args))
    )

    # status
    p_status = subparsers.add_parser("status", help="Show hyprCRD status")
    p_status.set_defaults(func=cmd_status)

    # doctor
    p_doc = subparsers.add_parser("doctor", help="Run system and component diagnostics")
    p_doc.set_defaults(func=cmd_doctor)

    # test
    p_test = subparsers.add_parser(
        "test",
        help="Run automated isolated test suite without affecting active session",
    )
    p_test.set_defaults(func=cmd_test)

    # install-host
    p_install = subparsers.add_parser(
        "install-host",
        help="Download and install the pinned Google CRD host components",
    )
    p_install.set_defaults(func=cmd_install_host)

    # check-host-update
    p_cupdate = subparsers.add_parser(
        "check-host-update",
        help="Compare the pinned CRD version against the latest upstream release",
    )
    p_cupdate.set_defaults(func=cmd_check_host_update)

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        sys.exit(0)

    args.func(args)


if __name__ == "__main__":
    main()

#!/usr/bin/env bash
# ==============================================================================
# hyprcrd-enroll: Enroll a new host (hyprEmpoleonTest) with Google Remote Desktop
# ==============================================================================

set -eo pipefail

BASE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BIN_DIR="$BASE_DIR/bin"
CONFIG_DIR="$HOME/.config/chrome-remote-desktop"

AUTH_CODE="$1"
HOST_NAME="${2:-hyprEmpoleonTest}"
PIN="${3:-00000000}"

if [ -z "$AUTH_CODE" ]; then
    echo "Usage: $0 <AUTH_CODE_FROM_GOOGLE> [HOST_NAME] [PIN]"
    echo ""
    echo "To get an AUTH_CODE:"
    echo "1. Visit: https://remotedesktop.google.com/headless in your browser"
    echo "2. Click 'Begin' -> 'Next' -> 'Authorize'"
    echo "3. Copy the Debian/Linux command generated by Google."
    echo "4. Pass the --code value here (or paste the entire command):"
    echo "   $0 \"4/0A...\""
    exit 1
fi

# If user pasted the whole command string, extract --code
if [[ "$AUTH_CODE" == *"--code="* ]]; then
    AUTH_CODE=$(echo "$AUTH_CODE" | grep -oP '(?<=--code=")[^"]*' || echo "$AUTH_CODE" | grep -oP '(?<=--code=)[^ ]*')
fi

echo "=== Enrolling host '$HOST_NAME' with PIN '$PIN' ==="

# Record existing configs before enrollment
BEFORE_CONFIGS=$(ls -1 "$CONFIG_DIR"/host#*.json 2>/dev/null || true)

# Run Google start-host binary
"$BIN_DIR/start-host" \
    --code="$AUTH_CODE" \
    --redirect-url="https://remotedesktop.google.com/_/oauthredirect" \
    --display-name="$HOST_NAME" \
    --pin="$PIN" \
    --disable-crash-reporting 2>&1 | tee /tmp/crd-enroll.log

# Detect new config file
AFTER_CONFIGS=$(ls -1 "$CONFIG_DIR"/host#*.json 2>/dev/null || true)
NEW_CONFIG=$(comm -13 <(echo "$BEFORE_CONFIGS" | sort) <(echo "$AFTER_CONFIGS" | sort) | head -1)

if [ -z "$NEW_CONFIG" ]; then
    # In case it updated in-place or created latest
    NEW_CONFIG=$(ls -t "$CONFIG_DIR"/host#*.json | head -1)
fi

echo "✓ Enrollment completed. Host config: $NEW_CONFIG"
echo "Host '$HOST_NAME' is registered with Google Remote Desktop!"

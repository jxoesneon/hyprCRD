# Maintainer: Eduardo <eduardo at hyprcrd dot org>
pkgname=hyprcrd-git
_pkgname=hyprcrd
pkgver=1.0.0.rc.1.r0.g1bc9195
pkgrel=1
pkgdesc="Native Wayland & PipeWire Host for Google Chrome Remote Desktop on Hyprland"
arch=('x86_64')
url="https://github.com/jxoesneon/hyprCRD"
license=('MIT' 'custom:google-chrome')
depends=(
    'pipewire'
    'xdg-desktop-portal-hyprland'
    'sdbus-c++'
    'libei'
    'libxkbcommon'
    'wayland'
    'python'
    'python-psutil'
)
makedepends=(
    'git'
    'cmake'
    'ninja'
    'wayland-protocols'
    'binutils'
    'gcc'
    'pkgconf'
)
provides=('hyprcrd')
conflicts=('hyprcrd')
install=hyprcrd.install
source=(
    "git+https://github.com/jxoesneon/hyprCRD.git"
    "https://dl.google.com/linux/chrome-remote-desktop/deb/pool/main/c/chrome-remote-desktop/chrome-remote-desktop_155.0.8059.19_amd64.deb"
)
sha256sums=(
    'SKIP'
    '39701c6951b3d9edff08143dccad919468e1866b9897c873141dc4f66baaff72'
)

pkgver() {
    cd "${srcdir}/hyprCRD"
    git describe --long --tags 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' || echo "r$(git rev-list --count HEAD).g$(git rev-parse --short HEAD)"
}

prepare() {
    cd "${srcdir}"
    # Unpack official Google Chrome Remote Desktop debian package
    bsdtar -xf chrome-remote-desktop_155.0.8059.19_amd64.deb data.tar.xz
    mkdir -p crd-deb-data
    bsdtar -xf data.tar.xz -C crd-deb-data
}

build() {
    cd "${srcdir}/hyprCRD"

    # 1. Build C++20 Portal Bridge
    cmake -B portal/build -S portal -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build portal/build

    # 2. Build Rootless PAM & PipeWire Protection Shim
    gcc ${CFLAGS} -shared -fPIC core/pam_shim.c -o bin/pam_shim.so \
        ${LDFLAGS} $(pkg-config --cflags --libs gio-2.0 libpipewire-0.3 pam) -ldl
}

package() {
    cd "${srcdir}/hyprCRD"

    # Install all hyprCRD-owned components, units, and example configuration.
    # Resolves @BINDIR@=/usr/bin and @LIBEXECDIR@=/usr/lib/hyprcrd.
    make install DESTDIR="${pkgdir}" PREFIX=/usr

    install -dm755 "${pkgdir}/usr/share/licenses/${pkgname}"
    install -m644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

    # Install official Google binaries extracted from .deb
    local DEB_ROOT="${srcdir}/crd-deb-data/opt/google/chrome-remote-desktop"
    install -m755 "${DEB_ROOT}/chrome-remote-desktop-host" "${pkgdir}/usr/lib/hyprcrd/chrome-remote-desktop-host"
    install -m644 "${DEB_ROOT}/libremoting_core.so" "${pkgdir}/usr/lib/hyprcrd/libremoting_core.so"
    install -m644 "${DEB_ROOT}/icudtl.dat" "${pkgdir}/usr/lib/hyprcrd/icudtl.dat"

    if [ -d "${DEB_ROOT}/remoting_locales" ]; then
        cp -r "${DEB_ROOT}/remoting_locales" "${pkgdir}/usr/lib/hyprcrd/"
    fi
}

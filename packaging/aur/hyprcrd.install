post_install() {
    echo ":: hyprCRD has been installed."
    echo ":: To link your machine to your Google Account, run:"
    echo "   hyprcrd enroll \"<COMMAND_FROM_remotedesktop.google.com/headless>\""
    echo "::"
    echo ":: To enable and start the hyprCRD background remoting host as a user service:"
    echo "   systemctl --user daemon-reload"
    echo "   systemctl --user enable --now hyprcrd.service"
    echo "::"
    echo ":: To verify runtime diagnostics:"
    echo "   hyprcrd doctor"
}

post_upgrade() {
    echo ":: If running hyprcrd as a systemd user service, reload and restart:"
    echo "   systemctl --user daemon-reload"
    echo "   systemctl --user restart hyprcrd.service"
}

post_remove() {
    echo ":: If you previously enabled hyprcrd as a user service, clean up with:"
    echo "   systemctl --user daemon-reload"
}
